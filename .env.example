# Required only for the sports consensus strategy.
ODDS_API_KEY=
# Cache paid sportsbook requests; sports discovery itself remains live.
SPORTS_ODDS_REFRESH_MS=1800000

# Paper trading is the only supported mode in this release.
PAPER_STARTING_CASH=1000
PAPER_STATE_PATH=data/paper-state.json
POLL_INTERVAL_MS=15000
DASHBOARD_PORT=3107
MIN_EXPECTED_EDGE=0.055
MAX_TRADE_USD=10
MAX_DAILY_LOSS_USD=25
MAX_OPEN_EXPOSURE_USD=30
MAX_SPREAD=0.06
# Optional comma-separated override. When omitted, only configured strategies are enabled.
# ENABLED_STRATEGIES=btc-5m-momentum,sports-odds-consensus
# BTC uses this as its model-agreement threshold (0 to 1).
MIN_STRATEGY_AGREEMENT=0.35
# Public OKX spot instrument used for BTC pricing. No credentials are required.
OKX_INSTRUMENT=BTC-USDT
# Exact Polymarket market mappings. Leave empty until each market is independently verified.
WEATHER_INSTRUMENTS_JSON=[]
# Optional manual override. When empty, eligible sports moneylines are matched automatically.
SPORTS_INSTRUMENTS_JSON=[]
MACRO_INSTRUMENTS_JSON=[]
# Comma-separated, manually reviewed binary-market slugs. Both outcomes must be exhaustive.
ARBITRAGE_MARKET_SLUGS=
# Paper baskets must lock at least this much profit after asks and taker fees.
ARBITRAGE_MIN_PROFIT_USD=0.25
